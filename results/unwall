<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <title>Unwall</title>
  <!-- Paket duvara çarpıyor: parçalarının çoğu duruyor, biri duvardaki
       gedikten geçip öbür tarafa çıkıyor. Motorun yaptığı işin kendisi:
       TLS mesajını bölüp DPI'ın tanıyamayacağı hale getirmek. -->
  <g id="ground">
    <rect width="512" height="512" rx="116" fill="#F2F0EA"/>
  </g>
  <g id="icon">
    <!-- duvar: ortasında gedik olan dikey engel -->
    <g fill="#14202B">
      <rect x="322" y="104" width="58" height="112" rx="29"/>
      <rect x="322" y="296" width="58" height="112" rx="29"/>
    </g>
    <!-- duvarda kalan paket parçaları -->
    <rect x="78" y="126" width="204" height="62" rx="31" fill="#14202B"/>
    <rect x="78" y="324" width="204" height="62" rx="31" fill="#14202B"/>
    <!-- gedikten geçip çıkan parça -->
    <rect x="78" y="225" width="356" height="62" rx="31" fill="#E4572E"/>
  </g>
</svg>
